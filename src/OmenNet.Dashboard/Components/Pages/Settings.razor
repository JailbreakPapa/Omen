@page "/settings"
@using OmenNet.Dashboard.Services
@using Microsoft.Extensions.Options
@inject IOptions<OmenNetOptions> Options

<PageTitle>Settings - OmenNet</PageTitle>

<div class="settings-page">
    <div class="page-header">
        <h1>Settings</h1>
    </div>
    
    <div class="settings-form">
        <div class="settings-section">
            <h2>Connection</h2>
            
            <div class="form-group">
                <label>Coordinator Address</label>
                <input type="text" @bind="CoordinatorAddress" />
                <span class="hint">The gRPC address of the OmenNet coordinator</span>
            </div>
            
            <div class="form-group">
                <label>Metrics Polling Interval (seconds)</label>
                <input type="number" @bind="PollingInterval" min="1" max="60" />
                <span class="hint">How often to refresh dashboard data</span>
            </div>
        </div>
        
        <div class="settings-section">
            <h2>Display</h2>
            
            <div class="form-group checkbox">
                <input type="checkbox" id="darkMode" checked />
                <label for="darkMode">Dark Mode</label>
            </div>
            
            <div class="form-group">
                <label>History Entries to Show</label>
                <input type="number" @bind="MaxHistoryEntries" min="10" max="1000" />
            </div>
        </div>
        
        <div class="form-actions">
            <button class="btn-primary" @onclick="SaveSettings">Save Settings</button>
        </div>
    </div>
</div>

@code {
    private string CoordinatorAddress { get; set; } = "";
    private int PollingInterval { get; set; } = 5;
    private int MaxHistoryEntries { get; set; } = 100;
    
    protected override void OnInitialized()
    {
        var opts = Options.Value;
        CoordinatorAddress = opts.CoordinatorAddress;
        PollingInterval = opts.MetricsPollingIntervalSeconds;
        MaxHistoryEntries = opts.MaxHistoryEntries;
    }
    
    private void SaveSettings()
    {
        // Settings would be saved to configuration
        // For now, just show a message
    }
}
