    <ProjectReference Include="..\Omen.Platforms\Omen.Platforms.csproj" />
    <ProjectReference Include="..\Omen.Executors\Omen.Executors.csproj" />
    <ProjectReference Include="..\Omen.Distributed\Omen.Distributed.csproj" />
    <ProjectReference Include="..\Omen.Optimizations\Omen.Optimizations.csproj" />
    <ProjectReference Include="..\OmenNet.Dashboard\OmenNet.Dashboard.csproj" />
  </ItemGroup>

</Project>
