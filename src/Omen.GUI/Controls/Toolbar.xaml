<UserControl x:Class="Omen.GUI.Controls.Toolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Omen.GUI.Controls"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Height="36">
    <Border Background="{StaticResource Brush.Panel}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="8,0">
        <DockPanel LastChildFill="True">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Open -->
                <Button Style="{StaticResource Style.Button.Toolbar}" Margin="0,0,4,0"
                        Click="OnOpenProjectClick" ToolTip="Open project">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgIcon UriSource="pack://application:,,,/Assets/Icons/folder-open.svg"
                                      Fill="{StaticResource Brush.TextPrimary}"
                                      Stretch="Uniform" Width="14" Height="14"
                                      Margin="0,0,6,0" />
                        <TextBlock Text="Open" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="18" Background="{StaticResource Brush.Border}" Margin="4,0" />

                <!-- Build -->
                <Button Style="{StaticResource Style.Button.ToolbarPrimary}" Margin="0,0,4,0"
                        Click="OnBuildClick" ToolTip="Build"
                        IsEnabled="{Binding IsBuilding, Converter={StaticResource Conv.InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgIcon UriSource="pack://application:,,,/Assets/Icons/bolt.svg" Fill="White"
                                      Stretch="Uniform" Width="14" Height="14"
                                      Margin="0,0,6,0" />
                        <TextBlock Text="Build" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Rebuild -->
                <Button Style="{StaticResource Style.Button.Toolbar}" Margin="0,0,4,0"
                        Click="OnRebuildClick" ToolTip="Rebuild"
                        IsEnabled="{Binding IsBuilding, Converter={StaticResource Conv.InverseBool}}">
                    <svgc:SvgIcon UriSource="pack://application:,,,/Assets/Icons/arrows-rotate.svg"
                                  Fill="{StaticResource Brush.TextPrimary}"
                                  Stretch="Uniform" Width="14" Height="14" />
                </Button>

                <!-- Clean -->
                <Button Style="{StaticResource Style.Button.Toolbar}" Margin="0,0,4,0"
                        Click="OnCleanClick" ToolTip="Clean"
                        IsEnabled="{Binding IsBuilding, Converter={StaticResource Conv.InverseBool}}">
                    <svgc:SvgIcon UriSource="pack://application:,,,/Assets/Icons/trash-can.svg"
                                  Fill="{StaticResource Brush.TextPrimary}"
                                  Stretch="Uniform" Width="14" Height="14" />
                </Button>

                <!-- Cancel -->
                <Button Style="{StaticResource Style.Button.Toolbar}" Margin="0,0,4,0"
                        Click="OnCancelClick" ToolTip="Cancel"
                        IsEnabled="{Binding IsCancellable}">
                    <svgc:SvgIcon UriSource="pack://application:,,,/Assets/Icons/circle-stop.svg"
                                  Fill="{StaticResource Brush.Error}"
                                  Stretch="Uniform" Width="14" Height="14" />
                </Button>

                <Border Width="1" Height="18" Background="{StaticResource Brush.Border}" Margin="4,0" />

                <!-- Platform / configuration: hidden when the build matrix is driving the build -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding MatrixPanel.IsActive,
                                         Converter={StaticResource Conv.BoolToVisibility},
                                         ConverterParameter=Invert}">
                    <TextBlock Text="Platform" Foreground="{StaticResource Brush.TextDim}" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0" />
                    <ComboBox MinWidth="110" VerticalAlignment="Center"
                              ItemsSource="{Binding AvailablePlatforms}"
                              SelectedItem="{Binding SelectedPlatform}" />
                    <TextBlock Text="Config" Foreground="{StaticResource Brush.TextDim}" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,4,0" />
                    <ComboBox MinWidth="110" VerticalAlignment="Center"
                              ItemsSource="{Binding Configurations}"
                              SelectedItem="{Binding SelectedConfiguration}" />
                </StackPanel>
            </StackPanel>

            <!-- Settings gear: flush right -->
            <Button DockPanel.Dock="Right" Width="26" Height="26" Style="{StaticResource Style.Button.Icon}"
                    Padding="6" Click="OnSettingsClick" ToolTip="Settings">
                <svgc:SvgIcon UriSource="pack://application:,,,/Assets/Icons/gear.svg"
                              Fill="{StaticResource Brush.TextSecondary}"
                              Stretch="Uniform" Width="14" Height="14" />
            </Button>

            <!-- Search pill: takes the remaining space between the action cluster and the gear. -->
            <Border DockPanel.Dock="Right" Width="220" Height="26" CornerRadius="14"
                    Background="{StaticResource Brush.InputBg}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    Margin="8,0" HorizontalAlignment="Right">
                <Grid Margin="8,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <svgc:SvgIcon Grid.Column="0" UriSource="pack://application:,,,/Assets/Icons/magnifying-glass.svg"
                                  Fill="{StaticResource Brush.TextDim}"
                                  Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"
                                  Margin="0,0,6,0" />

                    <controls:PlaceholderTextBox Grid.Column="1" Placeholder="Search everywhere"
                                                  Background="Transparent" BorderThickness="0"
                                                  Padding="0" VerticalAlignment="Center"
                                                  Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Grid.Column="2" Background="Transparent"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                        <TextBlock Text="⇧⇧" FontSize="10" Foreground="{StaticResource Brush.TextDimmer}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Flexible spacer between the action cluster and the search pill / gear. -->
            <Grid />
        </DockPanel>
    </Border>
</UserControl>

