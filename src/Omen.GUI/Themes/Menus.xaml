<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Rider-style dark ContextMenu: SurfaceRaised popup body, Border hairline, no drop shadow chrome. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True" Style="{x:Null}">
                            <ItemsPresenter Margin="{TemplateBinding Padding}"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MenuItem.PrepareContainerForItemOverride calls
         SetResourceReference(StyleProperty, MenuItem.SeparatorStyleKey) on every Separator hosted
         inside a Menu/ContextMenu - a local value that beats this implicit TargetType style, so
         the burger-menu separators need the keyed style below too, or they render as stock light
         Aero lines. Kept this implicit style too (no separators use it today, but it is harmless
         and covers any future bare/non-menu Separator). -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Brush.Border}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,4" />
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Brush.Border}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
    </Style>

    <!-- The top-level Menu bar itself (File/Build/Project/Tools/Help). -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Brush.BarRaised}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Dropdown template for a top-level header (Role=TopLevelHeader): File/Build/Project/Tools/
         Help. Swapped in via the Role trigger below rather than living as its own top-level
         Style, so both roles stay covered by the one implicit MenuItem style. -->
    <ControlTemplate x:Key="Template.MenuItem.TopLevelHeader" TargetType="MenuItem">
        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="{StaticResource Brush.PopupBg}"
                            BorderBrush="{StaticResource Brush.PopupBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinWidth="210"
                            Padding="4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True" Style="{x:Null}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.HoverAlt}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.HoverAlt}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Base template covers Role=SubmenuItem / SubmenuHeader (falls back for the unused
         TopLevelItem role too); the Role trigger below swaps in the TopLevelHeader template. -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Data="M1,4 L4,7 L9,1"
                                  Stroke="{StaticResource Brush.TextPrimary}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  Margin="1,0,0,0" />

                            <ContentPresenter Grid.Column="1"
                                               ContentSource="Header"
                                               RecognizesAccessKey="True"
                                               VerticalAlignment="Center"
                                               Margin="4,0,8,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       VerticalAlignment="Center" />

                            <Path x:Name="Arrow"
                                  Grid.Column="3"
                                  Data="M0,0 L4,3.5 L0,7 Z"
                                  Fill="{StaticResource Brush.TextSecondary}"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{StaticResource Brush.Panel}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True" Style="{x:Null}">
                                        <ItemsPresenter Margin="4" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.MenuItemHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Role is a MenuItemRole enum; this is the fourth role (TopLevelHeader) not already
                 covered by the base template above (which serves SubmenuItem/SubmenuHeader and
                 falls back for the unused TopLevelItem role). -->
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Template.MenuItem.TopLevelHeader}" />
                <Setter Property="Padding" Value="10,5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Stock is a pale yellow-white box; align to the same SurfaceRaised/Border popup treatment. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

