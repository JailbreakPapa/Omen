<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
                    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Reskin note: AvalonDock's DockingManager assigns AnchorablePaneControlStyle and
        DocumentPaneControlStyle as *local values* on each pane it creates (see its own
        generic.xaml: <Setter Property="AnchorablePaneControlStyle" Value="{StaticResource
        AnchorablePaneControlStyle}" /> inside DockingManager's own default style). A local
        value always wins over an implicit type-keyed style, so a plain
        `<Style TargetType="{x:Type avalonDock:LayoutAnchorablePaneControl}">` in this
        dictionary is silently ignored - that was the root cause of the "AvalonDock default
        chrome" bug. The two named styles below (Style.AnchorablePaneControl /
        Style.DocumentPaneControl) are assigned explicitly onto the DockingManager element in
        MainWindow.xaml via the matching properties, which is the mechanism AvalonDock itself
        exposes for reskinning panes.
    -->

    <!-- Small flat glyph button (pin/close/etc.) shared by pane titles and tab close buttons. -->
    <Style x:Key="Style.Docking.GlyphButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tool-window tab header (content of the tab strip's TabItem.Header): flat, no background
         change on select, accent underline + brighter foreground when active. -->
    <Style TargetType="{x:Type avalonDock:LayoutAnchorableTabItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalonDock:LayoutAnchorableTabItem}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="14,0" Height="30"
                            TextBlock.FontSize="12" TextBlock.Foreground="{StaticResource Brush.TextMono}">
                        <ContentPresenter Content="{Binding Model.Title,
                                          RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource Brush.Hover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Model.IsActive,
                                     RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Root" Property="TextBlock.Foreground"
                                    Value="{StaticResource Brush.TextPrimary}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Document tab header (e.g. "Welcome"): same flat/underline treatment, plus a close glyph. -->
    <Style TargetType="{x:Type avalonDock:LayoutDocumentTabItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalonDock:LayoutDocumentTabItem}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="14,0" Height="30"
                            TextBlock.FontSize="12" TextBlock.Foreground="{StaticResource Brush.TextMono}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{Binding Model.Title,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                              VerticalAlignment="Center" />
                            <Button x:Name="DocumentCloseButton" Grid.Column="1"
                                    Command="{Binding Path=LayoutItem.CloseCommand,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource Style.Docking.GlyphButton}"
                                    Margin="8,0,0,0" Visibility="Hidden">
                                <svgc:SvgIcon UriSource="pack://application:,,,/Assets/Icons/xmark.svg"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Stretch="Uniform" Width="9" Height="9" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource Brush.Hover}" />
                            <Setter TargetName="DocumentCloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Model.IsActive,
                                     RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Root" Property="TextBlock.Foreground"
                                    Value="{StaticResource Brush.TextPrimary}" />
                            <Setter TargetName="DocumentCloseButton" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Single-anchorable pane title bar (shown when a pane has only one tool window, so its tab
         strip is collapsed): title text + auto-hide/close glyphs. Genuinely applies via normal
         implicit-style lookup (AvalonDock's own AnchorablePaneTitle style is itself unkeyed). -->
    <Style TargetType="{x:Type avalonDock:AnchorablePaneTitle}">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalonDock:AnchorablePaneTitle}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{Binding Model.Title,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Converter={StaticResource Conv.UpperCase}}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                            <!-- Auto-hide ("-") button intentionally omitted: the rails are this
                                 app's show/hide affordance, and AvalonDock's auto-hide strip is
                                 unthemed - a second, competing show/hide mechanism here would
                                 desync from the rail icon state. -->
                            <Button x:Name="PART_HidePin" Grid.Column="1"
                                    Command="{Binding Path=LayoutItem.HideCommand,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource Style.Docking.GlyphButton}"
                                    Foreground="{StaticResource Brush.TextMuted}">
                                <svgc:SvgIcon UriSource="pack://application:,,,/Assets/Icons/xmark.svg"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Stretch="Uniform" Width="9" Height="9" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.CanClose, RelativeSource={RelativeSource Mode=Self}}"
                                     Value="True">
                            <Setter TargetName="PART_HidePin" Property="Command"
                                    Value="{Binding Path=LayoutItem.CloseCommand,
                                            RelativeSource={RelativeSource TemplatedParent}}" />
                        </DataTrigger>
                        <Trigger SourceName="PART_HidePin" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_HidePin" Property="Foreground"
                                    Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pane chrome: header strip and content both on Brush.Panel (anchorable panes are the
         side tool windows, not the main content surface), hairline border.
         Assigned explicitly via DockingManager.AnchorablePaneControlStyle in MainWindow.xaml (see
         note above) - an implicit TargetType style here would never be reached. -->
    <Style x:Key="Style.AnchorablePaneControl" TargetType="{x:Type avalonDock:LayoutAnchorablePaneControl}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="TabStripPlacement" Value="Bottom" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalonDock:LayoutAnchorablePaneControl}">
                    <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Required to catch mouse events over the whole pane. -->
                        <Border Grid.RowSpan="2" Background="Transparent" />
                        <Border x:Name="ContentPanel" Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Cycle">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <avalonDock:AnchorablePaneTabPanel x:Name="HeaderPanel" Grid.Row="1"
                                                            Background="{StaticResource Brush.Panel}"
                                                            Panel.ZIndex="1" IsItemsHost="True"
                                                            KeyboardNavigation.TabIndex="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- The outer TabItem container AvalonDock generates per tab (its Header content is the
             LayoutAnchorableTabItem styled above). This is what rendered "stock light-grey Windows
             chrome" - AvalonDock's own version hardcodes Background="White" on selection and
             SystemColors.GradientInactiveCaptionBrushKey on hover. -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                    <!-- Transparent pass-through: the accent underline / active-vs-inactive
                         foreground / hover highlight are all owned by the inner
                         LayoutAnchorableTabItem / LayoutDocumentTabItem content (see above), so
                         this outer TabItem wrapper does not swap background on its own. -->
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <ContentPresenter x:Name="Content"
                                                      HorizontalAlignment="{Binding HorizontalContentAlignment,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                      VerticalAlignment="{Binding VerticalContentAlignment,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Selector.IsSelected" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Collapse the tab strip entirely when the pane has only one tool window
                             (AnchorablePaneTitle is shown instead) - preserved from AvalonDock's default. -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor,
                                     AncestorType={x:Type TabControl}}, Path=Items.Count, FallbackValue=1}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <avalonDock:LayoutAnchorableTabItem Model="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <avalonDock:LayoutAnchorableControl Model="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Document pane chrome (centre pane, e.g. "Welcome"): tabs on top, same flat treatment as the
         anchorable pane. Also assigned explicitly, via DockingManager.DocumentPaneControlStyle. -->
    <Style x:Key="Style.DocumentPaneControl" TargetType="{x:Type avalonDock:LayoutDocumentPaneControl}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Bg}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalonDock:LayoutDocumentPaneControl}">
                    <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Background="Transparent" />
                        <avalonDock:DocumentPaneTabPanel x:Name="HeaderPanel" Grid.Row="0"
                                                          Background="{StaticResource Brush.Panel}"
                                                          IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        <Border x:Name="ContentPanel" Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Cycle">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!--
            Scope cut: AvalonDock's default DocumentPaneControlStyle also draws a "..." overflow
            drop-down button (MenuDropDownButton) that lists documents when the tab strip runs out
            of room, wired to AvalonDock.Properties resource strings and a nested ContextMenuEx
            style. With a single "Welcome" document there is nothing to overflow, so it is left out
            here rather than reimplemented speculatively; add it back (mirroring AvalonDock's
            generic.xaml DocumentPaneControlStyle) if/when a later task adds enough documents that
            overflow becomes reachable.
        -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                    <!-- Transparent pass-through: the accent underline / active-vs-inactive
                         foreground / hover highlight are all owned by the inner
                         LayoutAnchorableTabItem / LayoutDocumentTabItem content (see above), so
                         this outer TabItem wrapper does not swap background on its own. -->
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <ContentPresenter x:Name="Content"
                                                      HorizontalAlignment="{Binding HorizontalContentAlignment,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                      VerticalAlignment="{Binding VerticalContentAlignment,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Selector.IsSelected" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <avalonDock:LayoutDocumentTabItem Model="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <avalonDock:LayoutDocumentControl Model="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type avalonDock:LayoutGridResizerControl}">
        <Setter Property="Background" Value="{StaticResource Brush.Border}" />
    </Style>

    <!-- Floating (torn-off) pane chrome: LayoutFloatingWindowControl is a plain Window subclass,
         so Background/BorderBrush are enough to stop it rendering as stock white - no custom
         template needed. Styled on both concrete subtypes (as well as the shared base) since a
         custom control's own DefaultStyleKey can make an implicit style on the base type alone
         unreliable. -->
    <Style x:Key="Style.Docking.FloatingWindow" TargetType="{x:Type avalonDock:LayoutFloatingWindowControl}">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PopupBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="{x:Type avalonDock:LayoutFloatingWindowControl}"
           BasedOn="{StaticResource Style.Docking.FloatingWindow}" />
    <Style TargetType="{x:Type avalonDock:LayoutAnchorableFloatingWindowControl}"
           BasedOn="{StaticResource Style.Docking.FloatingWindow}" />
    <Style TargetType="{x:Type avalonDock:LayoutDocumentFloatingWindowControl}"
           BasedOn="{StaticResource Style.Docking.FloatingWindow}" />

</ResourceDictionary>

