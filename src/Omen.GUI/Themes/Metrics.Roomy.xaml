<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Roomy density. Standard lives in Metrics.xaml, Compact in Metrics.Compact.xaml. -->
    <Thickness x:Key="Metric.RowPadding">12,9,12,9</Thickness>
    <sys:Double x:Key="Metric.PanelHeaderHeight">32</sys:Double>
    <sys:Double x:Key="Metric.ToolbarButtonHeight">30</sys:Double>
    <sys:Double x:Key="Metric.FontSizeBody">13.5</sys:Double>
    <sys:Double x:Key="Metric.FontSizeMono">13</sys:Double>

</ResourceDictionary>
