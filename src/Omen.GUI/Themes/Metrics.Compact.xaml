<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Compact density. Standard lives in Metrics.xaml, Roomy in Metrics.Roomy.xaml. -->
    <Thickness x:Key="Metric.RowPadding">8,3,8,3</Thickness>
    <sys:Double x:Key="Metric.PanelHeaderHeight">24</sys:Double>
    <sys:Double x:Key="Metric.ToolbarButtonHeight">22</sys:Double>
    <sys:Double x:Key="Metric.FontSizeBody">11.5</sys:Double>
    <sys:Double x:Key="Metric.FontSizeMono">11</sys:Double>

</ResourceDictionary>
