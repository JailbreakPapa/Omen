<UserControl x:Class="Omen.GUI.Views.UnsavedChangesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!-- Overlay across the whole window; visible only while a close is pending on a dirty
         rule-file document. DataContext is the owning RuleEditorPanelViewModel (see
         MainWindow.xaml), same pattern as SettingsDialog/SearchOverlay one level up. -->
    <Grid Visibility="{Binding IsUnsavedPromptOpen, Converter={StaticResource Conv.BoolToVisibility}}">

        <!-- No backdrop-click-to-dismiss here, unlike Settings/Search: silently discarding
             edits to a file that drives the build must be a deliberate click, not a stray one. -->
        <Border Background="{StaticResource Brush.ModalScrim}" />

        <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PopupBorder}" BorderThickness="1"
                CornerRadius="8"
                MouseDown="OnDialogMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="20" Opacity="0.6" Color="Black" />
            </Border.Effect>

            <StackPanel Margin="20">
                <TextBlock Text="Unsaved changes" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}" />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}">
                    <Run Text="'" /><Run Text="{Binding PendingCloseDocument.FileName, Mode=OneWay}" /><Run
                        Text="' has unsaved changes. Save them before closing?" />
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel" Height="28" Padding="14,0" Margin="0,0,8,0"
                            Background="Transparent" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" Click="OnCancelClick" />
                    <Button Content="Don't Save" Height="28" Padding="14,0" Margin="0,0,8,0"
                            Background="Transparent" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" Click="OnDontSaveClick" />
                    <Button Content="Save" Height="28" Padding="14,0"
                            Style="{StaticResource Style.Button.ToolbarPrimary}"
                            Click="OnSaveClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
