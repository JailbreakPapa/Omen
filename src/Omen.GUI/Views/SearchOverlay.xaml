<UserControl x:Class="Omen.GUI.Views.SearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Omen.GUI.Controls"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Visibility="{Binding IsSearchOpen, Converter={StaticResource Conv.BoolToVisibility}}"
             Panel.ZIndex="100">

    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedResults" Source="{Binding QuickSearchResults}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <!-- Scrim: clicking outside the panel dismisses, same as Escape. -->
    <Border Background="{StaticResource Brush.Scrim}" MouseLeftButtonDown="OnScrimClick">
        <Border Width="560" MaxHeight="520" VerticalAlignment="Top" Margin="0,90,0,0"
                Background="{StaticResource Brush.PopupBg}"
                BorderBrush="{StaticResource Brush.PopupBorder}" BorderThickness="1"
                CornerRadius="8" SnapsToDevicePixels="True"
                MouseLeftButtonDown="OnPanelClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="20" Opacity="0.6" Color="Black" />
            </Border.Effect>

            <DockPanel>
                <!-- Query box -->
                <Border DockPanel.Dock="Top" Margin="10" Height="44" CornerRadius="6"
                        Background="{StaticResource Brush.InputBg}"
                        BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <svgc:SvgIcon Grid.Column="0" UriSource="pack://application:,,,/Assets/Icons/magnifying-glass.svg"
                                      Fill="{StaticResource Brush.Accent}"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"
                                      Margin="0,0,10,0" />

                        <controls:PlaceholderTextBox x:Name="QueryBox" Grid.Column="1"
                                                     Placeholder="Search everywhere"
                                                     Background="Transparent" BorderThickness="0"
                                                     FontSize="15" Padding="0" VerticalAlignment="Center"
                                                     Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="OnQueryKeyDown" />

                        <Button Grid.Column="2" Width="22" Height="22" Padding="0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="OnCloseClick" ToolTip="Close">
                            <svgc:SvgIcon UriSource="pack://application:,,,/Assets/Icons/xmark.svg"
                                          Fill="{StaticResource Brush.TextMuted}"
                                          Stretch="Uniform" Width="12" Height="12" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Footer hints -->
                <Border DockPanel.Dock="Bottom" Height="34" Padding="12,0"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Style.KeyCap}">
                            <TextBlock Text="&#x21B5;" />
                        </Border>
                        <TextBlock Text="to select" Style="{StaticResource Style.KeyCapLabel}" />
                        <Border Style="{StaticResource Style.KeyCap}">
                            <TextBlock Text="&#x2193;" />
                        </Border>
                        <Border Style="{StaticResource Style.KeyCap}">
                            <TextBlock Text="&#x2191;" />
                        </Border>
                        <TextBlock Text="to navigate" Style="{StaticResource Style.KeyCapLabel}" />
                        <Border Style="{StaticResource Style.KeyCap}">
                            <TextBlock Text="esc" />
                        </Border>
                        <TextBlock Text="to close" Style="{StaticResource Style.KeyCapLabel}" />
                    </StackPanel>
                </Border>

                <!-- Results -->
                <Grid>
                    <TextBlock Text="No matches." Margin="22,6,0,14" FontSize="12"
                               Foreground="{StaticResource Brush.TextDim}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding QuickSearchResults.Count}" Value="0" />
                                            <Condition Binding="{Binding QuickSearch, Converter={StaticResource Conv.IsNotEmpty}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox x:Name="ResultList"
                             ItemsSource="{Binding Source={StaticResource GroupedResults}}"
                             SelectedIndex="{Binding SelectedSearchIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             Margin="0,0,0,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseLeftButtonUp="OnResultClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="12,8,0,4"
                                                   FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Accent}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,7" />
                                <Setter Property="Margin" Value="6,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="{StaticResource Brush.Hover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="{StaticResource Brush.SelectedBg}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextDim}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#x21B5;" FontSize="13"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource Brush.AccentIcon}"
                                               Visibility="{Binding IsSelected,
                                                            RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                            Converter={StaticResource Conv.BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Border>
</UserControl>
