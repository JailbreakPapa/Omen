<UserControl x:Class="Omen.GUI.Views.Settings.SettingsDistributedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Omen.GUI.Controls">
    <StackPanel Margin="24">
        <TextBlock Text="Distributed builds (OmenNet)" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,16" />

        <CheckBox Content="Enable distributed builds"
                  IsChecked="{Binding EnableDistributedBuilds}"
                  Margin="0,0,0,16" />

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Coordinator address" Style="{StaticResource Style.Text.Secondary}" Margin="0,0,0,4" />
            <TextBox Text="{Binding CoordinatorAddress, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding EnableDistributedBuilds}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                     Width="180" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Local agent jobs" Style="{StaticResource Style.Text.Secondary}" Margin="0,0,0,4" />
            <controls:NumericTextBox Value="{Binding LocalAgentJobs}"
                                      IsEnabled="{Binding EnableDistributedBuilds}"
                                      Width="80" HorizontalAlignment="Left" />
            <TextBlock Text="Saved, but not yet applied — no build agent currently consumes this value."
                       Foreground="{StaticResource Brush.TextDim}" FontSize="11"
                       Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
