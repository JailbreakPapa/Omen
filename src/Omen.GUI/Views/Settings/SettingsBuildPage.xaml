<UserControl x:Class="Omen.GUI.Views.Settings.SettingsBuildPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Omen.GUI.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <StackPanel MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Build" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,14" />

        <!-- Row: Default configuration -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Default configuration" FontSize="12.5"
                       Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Width="180" SelectedItem="{Binding DefaultConfiguration}">
                <sys:String>Development</sys:String>
                <sys:String>Debug</sys:String>
                <sys:String>Shipping</sys:String>
            </ComboBox>
        </Grid>

        <!-- Row: Parallel jobs -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Parallel jobs" FontSize="12.5"
                       Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
            <controls:NumericTextBox Grid.Column="1" Width="80" Value="{Binding ParallelJobs}" />
        </Grid>

        <!-- Row: Use Unity builds -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Use Unity builds" FontSize="12.5"
                       Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" IsChecked="{Binding UseUnityBuilds}" VerticalAlignment="Center" />
        </Grid>

        <!-- Row: Use precompiled headers -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Use precompiled headers" FontSize="12.5"
                       Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" IsChecked="{Binding UsePrecompiledHeaders}" VerticalAlignment="Center" />
        </Grid>

        <!-- Row: Enable link-time optimization -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Enable link-time optimization" FontSize="12.5"
                       Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" IsChecked="{Binding EnableLto}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="Saved, but not yet applied to builds - LTO is controlled by the project's own target rules and is currently unreachable from the build request."
                   FontSize="11" Foreground="{DynamicResource Brush.TextDim}"
                   TextWrapping="Wrap" Margin="0,0,0,14" />
    </StackPanel>
</UserControl>
