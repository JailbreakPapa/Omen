<UserControl x:Class="Omen.GUI.Views.BuildOutputToolWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Omen.GUI.Converters"
             xmlns:views="clr-namespace:Omen.GUI.Views"
             xmlns:models="clr-namespace:Omen.GUI.Models"
             Background="{StaticResource Brush.Bg}">
    <UserControl.Resources>
        <conv:OutputLevelToBrushConverter x:Key="LevelToBrush" />
        <views:AlternationIndexToLineNumberConverter x:Key="LineNumber" />

        <Style x:Key="OutputTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Height="30"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="Build Output"
                        Click="OnOutputTabClick">
                    <Button.Style>
                        <Style BasedOn="{StaticResource OutputTabButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveOutputTab}" Value="output">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Click="OnProblemsTabClick">
                    <Button.Style>
                        <Style BasedOn="{StaticResource OutputTabButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveOutputTab}" Value="problems">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Problems" VerticalAlignment="Center" />
                        <Border CornerRadius="8"
                                Background="{StaticResource Brush.Border}"
                                Padding="6,0"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProblemCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ProblemCount}"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       FontSize="10.5"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!--
             AlternationCount must exceed the largest expected line count or the index wraps
             and line numbers silently repeat/reset. int.MaxValue (2147483647) below is that
             ceiling - a build log realistically never approaches it.
        -->
        <ListBox x:Name="OutputList"
                 ItemsSource="{Binding VisibleOutputLines}"
                 FontFamily="{StaticResource Font.Mono}"
                 FontSize="12"
                 AlternationCount="2147483647"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:OutputLine}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource LineNumber}}"
                                   TextAlignment="Right"
                                   Margin="0,0,12,0"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource Brush.TextDimmer}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="12"
                                   LineHeight="20"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Text}"
                                   TextWrapping="NoWrap"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="12"
                                   LineHeight="20"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

