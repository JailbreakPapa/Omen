<UserControl x:Class="Omen.GUI.Views.AboutDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsAboutOpen, Converter={StaticResource Conv.BoolToVisibility}}"
             Panel.ZIndex="120">

    <!-- Scrim: a click outside dismisses, same as Escape and the Close button. -->
    <Border Background="{StaticResource Brush.ModalScrim}" MouseLeftButtonDown="OnScrimClick">
        <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.PopupBorder}" BorderThickness="1"
                CornerRadius="8" SnapsToDevicePixels="True"
                MouseLeftButtonDown="OnPanelClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="20" Opacity="0.6" Color="Black" />
            </Border.Effect>

            <StackPanel Margin="24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Image Source="pack://application:,,,/Assets/omen-icon-64.png"
                           Width="40" Height="40" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Omen" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding AboutVersion}" FontSize="11.5"
                                   FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{StaticResource Brush.TextMono}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Text="A fast, scalable C/C++ build system with pure C# rule definitions, distributed builds over OmenNet, and content-addressed incremental caching." />

                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,16,0,14" />

                <TextBlock Text="{Binding AboutRuntime}" FontSize="11"
                           FontFamily="{StaticResource Font.Mono}"
                           Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Documentation" Height="28" Padding="14,0" Margin="0,0,8,0"
                            Click="OnDocumentationClick" />
                    <Button Content="Close" Height="28" Padding="14,0" Click="OnCloseClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
